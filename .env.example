# Optional. Only needed if this app is NOT running on a machine already
# authenticated via `claude login` (the Claude Agent SDK reuses that login
# automatically). Set this if you want the app to authenticate independently,
# e.g. when deploying it somewhere other than your own dev machine.
ANTHROPIC_API_KEY=

# Optional. Enables the run_readonly_query tool (SELECT-only database
# validation). Leave both blank to keep the agent generating SQL as text
# without executing it. DB_ENGINE must be exactly "postgres" or "mysql".
DB_ENGINE=
DATABASE_URL=

# Optional. Enables Jira read/write tools (jira_search_issues, jira_get_issue,
# jira_create_issue, jira_transition_issue, jira_add_comment). Leave blank to
# keep Jira disconnected. JIRA_API_TOKEN: generate one at
# https://id.atlassian.com/manage-profile/security/api-tokens (Jira Cloud only
# — Jira Server/Data Center uses a different auth scheme, not supported here).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
