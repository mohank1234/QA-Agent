# Required. Points Prisma at this app's OWN database (not the same thing as
# DB_ENGINE/DATABASE_URL below, which is a user's separate external database
# for the QA validation tool). A Postgres connection string — this app uses
# Neon (https://neon.tech, free tier) for both local dev and production, the
# same database either way. Format:
#   postgresql://user:password@host/dbname?sslmode=require
APP_DATABASE_URL=

# Optional. Only needed if this app is NOT running on a machine already
# authenticated via `claude login` (the Claude Agent SDK reuses that login
# automatically). Set this if you want the app to authenticate independently,
# e.g. when deploying it somewhere other than your own dev machine.
ANTHROPIC_API_KEY=

# Required. Auth.js session/cookie signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this logs everyone out (invalidates all existing sessions).
AUTH_SECRET=

# Optional. Enables "Sign in with Google". Leave blank to keep only
# email/password login. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials — authorized redirect
# URI: <your-app-url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. Sends real "forgot password" emails via Resend when set; leave
# blank to have the reset link logged to the server console instead (fine
# for local dev). Get a key at https://resend.com (free tier available).
RESEND_API_KEY=
EMAIL_FROM=

# Optional. Enables the agent's run_readonly_query tool (SELECT-only
# validation against a database YOU are testing — unrelated to this app's
# own storage above). Leave both blank to keep the agent generating SQL as
# text without executing it. DB_ENGINE must be exactly "postgres" or "mysql".
DB_ENGINE=
DATABASE_URL=

# Optional. Enables Jira read/write tools (jira_search_issues, jira_get_issue,
# jira_create_issue, jira_transition_issue, jira_add_comment). Leave blank to
# keep Jira disconnected. JIRA_API_TOKEN: generate one at
# https://id.atlassian.com/manage-profile/security/api-tokens (Jira Cloud only
# — Jira Server/Data Center uses a different auth scheme, not supported here).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional. Controls src/lib/logger.ts (Pino) verbosity — one of trace,
# debug, info, warn, error, fatal, silent. Defaults to "debug" in dev,
# "info" in production if unset.
LOG_LEVEL=

# Required. Cloudflare R2 (S3-compatible) — where uploaded documents, .xlsx
# exports, and generated .docx files actually live (src/lib/storage.ts).
# 1. Create a bucket: dash.cloudflare.com -> R2 Object Storage -> Create bucket
# 2. Create an API token scoped to it: R2 -> Manage API Tokens -> Create API
#    Token (permissions: Object Read & Write) -> gives you the access key ID
#    and secret access key below.
# 3. R2_ACCOUNT_ID is in the Cloudflare dashboard sidebar (or R2 -> Overview).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional. Error monitoring — every logger.error()/logger.fatal() call
# (src/lib/logger.ts) also reports to Sentry when this is set; errors just
# stay in the Pino logs otherwise. Create a project at https://sentry.io
# (free tier) and copy its DSN.
SENTRY_DSN=

# Optional. Analytics — tracks signup/project_created/chat_message_sent
# server-side (src/lib/analytics.ts) when set; events are simply not sent
# otherwise. Create a project at https://posthog.com (free tier) for the API
# key. POSTHOG_HOST defaults to https://us.i.posthog.com if unset (use your
# project's actual region, e.g. https://eu.i.posthog.com, if it's EU-hosted).
POSTHOG_API_KEY=
POSTHOG_HOST=
